PORT=3000
# Set both values to use the PayPal sandbox REST adapter. Leave blank for mock mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required only for verified PayPal webhook ingestion at POST /api/webhooks/paypal.
PAYPAL_WEBHOOK_ID=
# Optional OpenAI-compatible extraction enhancement. Deterministic parsing remains the fallback.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
