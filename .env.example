PORT=3000
# Set both values to use the PayPal sandbox REST adapter. Leave blank for mock mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required only for verified PayPal webhook ingestion at POST /api/webhooks/paypal.
PAYPAL_WEBHOOK_ID=
# AI provider selection: auto, deterministic, ollama, openai, grok/xai, or gemini/google.
# auto prefers configured cloud keys (OpenAI, xAI/Grok, Gemini), then detects local Ollama.
AI_PROVIDER=auto
# Optional shared AI request timeout. Provider failures always fall back to deterministic parsing.
AI_TIMEOUT_MS=10000

# OpenAI (OpenAI-compatible chat completions)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# xAI / Grok (OpenAI-compatible chat completions)
XAI_API_KEY=
# GROK_API_KEY=  # accepted as an alias for XAI_API_KEY
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-3-mini
# GROK_MODEL=grok-3-mini  # accepted as an alias for XAI_MODEL

# Gemini / Google (OpenAI-compatible compatibility endpoint)
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # accepted as an alias for GEMINI_API_KEY
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-2.0-flash

# Local Ollama (the no-key path; install Ollama and pull the model locally)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_PROBE_URL=http://127.0.0.1:11434/api/tags
# OLLAMA_PROBE_TIMEOUT_MS=250
