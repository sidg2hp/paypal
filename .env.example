# ---------------------------------------------------------------------------
# Cashflow Copilot environment. Copy to .env for a local loader, or export.
# Everything is optional: with no values the app runs a complete offline demo
# with the deterministic planner and the mock PayPal adapter.
# ---------------------------------------------------------------------------

# HTTP
PORT=3000
# Public origin used for PayPal return/cancel URLs. Leave blank to derive it
# from the request (works locally and on Render with TRUST_PROXY=1).
# PUBLIC_BASE_URL=https://your-demo.example
# Set to 1 when behind a trusted reverse proxy (Render, Fly, nginx).
# TRUST_PROXY=1
# MERCHANT_NAME=Cashflow Copilot

# ---------------------------------------------------------------------------
# PayPal Sandbox (optional). Set BOTH values to use the live sandbox adapter.
# Copy from the SANDBOX tab in Apps & Credentials, and click Show next to the
# secret before copying. Live credentials will fail with invalid_client.
# PowerShell: use single quotes so a $ inside the secret is not expanded:
#   $env:PAYPAL_CLIENT_ID = '...'
#   $env:PAYPAL_CLIENT_SECRET = '...'
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required only for verified webhook ingestion at POST /api/webhooks/paypal.
PAYPAL_WEBHOOK_ID=
# Optional overrides for a different PayPal environment or branding. Leave
# PAYPAL_BASE_URL unset unless it matches the credentials above.
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_BRAND_NAME=Cashflow Copilot
# PAYPAL_INVOICER_EMAIL=merchant@example.com
# PAYPAL_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# AI planner and extraction (optional). Failures always fall back to the
# deterministic parser, and keys are never returned by the API.
# ---------------------------------------------------------------------------
# auto, deterministic, ollama, openai, grok/xai, or gemini/google.
AI_PROVIDER=auto
AI_TIMEOUT_MS=10000

# OpenAI-compatible
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# xAI / Grok (OpenAI-compatible)
XAI_API_KEY=
# GROK_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-3-mini

# Gemini / Google (OpenAI-compatible endpoint)
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.0-flash

# Local Ollama (the no-key path)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_PROBE_URL=http://127.0.0.1:11434/api/tags
# OLLAMA_PROBE_TIMEOUT_MS=250

# ---------------------------------------------------------------------------
# Demo and operations
# ---------------------------------------------------------------------------
# Optional JSON persistence. Leave blank for the in-memory demo store.
# DATA_FILE=./data/store.json
# Optional policy override. Defaults to policies/collections.json.
# POLICY_FILE=./policies/collections.json
# Protect POST /api/demo/reset on a public deployment.
DEMO_RESET_SECRET=
# Set to false to disable POST /api/webhooks/simulate.
# ALLOW_WEBHOOK_SIMULATION=true
# Rate limiting (per IP, 60s window).
# RATE_LIMIT_DISABLED=0
# RATE_LIMIT_MAX=240
# RATE_LIMIT_WRITE_MAX=60

# Real Sandbox evidence run (scripts/sandbox-check.js)
# SANDBOX_TEST_EMAIL=sb-buyer@business.example.com
# SANDBOX_TEST_CURRENCY=USD
